  "presentation_screens_tela_desenvolvimento_2": ". Para críticas, sugerencias y contactos envía un email a ",
  "@presentation_screens_tela_desenvolvimento_2": {
    "description": ". Para críticas, sugestões e contatos envie um email para ",
