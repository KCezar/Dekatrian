  "presentation_screens_tela_dekatrian_0": "Dekatrian Info",
  "@presentation_screens_tela_dekatrian_0": {
    "description": "Informações Dekatrian",
    "type": "text"
  },
  "presentation_screens_tela_dekatrian_1": "Dekatrian is a calendar devised by a member of the Scicast podcast team:\n\n Roberto Spinelli.",
  "@presentation_screens_tela_dekatrian_1": {
    "description": "Descrição do calendário Dekatrian",
    "type": "text"
  },
  "presentation_screens_tela_dekatrian_2": "Visit the Deviante page or the Dekatrian Facebook group to learn more.",
  "@presentation_screens_tela_dekatrian_2": {
    "description": "Descrição do grupo do facebook Dekatrian",
    "type": "text"
  },
  "presentation_screens_tela_dekatrian_3": "http://www.deviante.com.br/podcasts/scicast/",
  "@presentation_screens_tela_dekatrian_3": {
    "description": "Link Deviante podcast",
    "type": "text"
  },
  "presentation_screens_tela_dekatrian_4": "www.deviante.com.br/podcasts/scicast/",
  "@presentation_screens_tela_dekatrian_4": {
    "description": "Link site Deviante podcast",
    "type": "text"
  },
  "presentation_screens_tela_dekatrian_5": "Dekatrian isn’t a new idea; this form of calendar was used in ancient times, such as in Egypt and Greece. The lunar calendar measures time based on the moon’s phases and is used by many cultures around the world. A more recent attempt to create a lunar calendar was made by Moses Bruines Cotsworth, who created the 13-month Yearal, each month having 28 days.",
  "@presentation_screens_tela_dekatrian_5": {
    "description": "Sobre o calendario de 13 meses e suas tentativas",
    "type": "text"
  },
  "presentation_screens_tela_dekatrian_6": "Why adopt Dekatrian?",
  "@presentation_screens_tela_dekatrian_6": {
    "description": "Por que adotar o Dekatrian?",
    "type": "text"
  },
  "presentation_screens_tela_dekatrian_7": "The Gregorian calendar we use today has several problems: months vary in length (28, 30 or 31 days), dates shift weekdays each year, and leap-year corrections are complex. Its structure was shaped by historical political decisions rather than logical or natural patterns. Dekatrian fixes these distortions by offering equal-length months, easier planning, and better alignment with natural cycles.",
  "@presentation_screens_tela_dekatrian_7": {
    "description": "Resposta do porque adotar o Dekatrian?",
    "type": "text"
  },
